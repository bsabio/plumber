# ─────────────────────────────────────────────────────────────────
# Pipe Dreams Plumbing — example environment file
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# never commit secrets.
# ─────────────────────────────────────────────────────────────────

# Required in production. Min 32 chars. Used to sign session cookies and to
# encrypt the user-supplied Gemini key cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Required in production. Neon Postgres connection string.
# Create a free project at https://neon.tech, copy the "Connection string"
# from the dashboard (the pooled `?sslmode=require` URL is recommended).
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Optional — server-wide Gemini API key for the AI chat features. Users can
# also supply their own key from the Admin → "Gemini Key" tab.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — Google OAuth for "Continue with Google". Set the redirect URI
# in the Google Cloud Console to <YOUR_ORIGIN>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — leave unset unless you're debugging the logger module.
# DEBUG=1
